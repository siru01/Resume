{
  "rewrites": [
    {
      "source": "/api/leetcode/:path*",
      "destination": "https://alfa-leetcode-api.onrender.com/userProfile/:path*"
    },
    {
      "source": "/api/lc-graphql",
      "destination": "https://leetcode.com/graphql"
    },
    {
      "source": "/api/wandbox/:path*",
      "destination": "https://wandbox.org/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
